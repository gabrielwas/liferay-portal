Bundle-Name: Liferay Object Web
Bundle-SymbolicName: com.liferay.object.web
Bundle-Version: 1.0.0
Provide-Capability:\
	liferay.resource.bundle;\
		resource.bundle.aggregate:String="(bundle.symbolic.name=com.liferay.object.lang)";\
		resource.bundle.base.name="content.Language",\
    osgi.extender;\
		osgi.extender="jsp.taglib";\
		uri="http://liferay.com/tld/ddm";\
		version:Version="${Bundle-Version}"
Web-ContextPath: /object-web
-dsannotations-options: inherit